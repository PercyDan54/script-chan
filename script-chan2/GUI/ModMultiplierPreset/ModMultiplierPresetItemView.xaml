<UserControl x:Class="script_chan2.GUI.ModMultiplierPresetItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:p="clr-namespace:script_chan2.Properties"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="800">
    <Border BorderBrush="LightGray" BorderThickness="0 0 0 2" Background="{Binding Background}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <ComboBox x:Name="Mod" ItemsSource="{Binding ModsList}" SelectedItem="{Binding Mods}"  VerticalAlignment="Center" Margin="5" MinWidth="60" />
                <TextBox Text="{Binding Multiplier}" md:HintAssist.Hint="Multiplier" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="5 0 5 0" />
                <Button x:Name="Delete" Style="{StaticResource MaterialDesignIconButton}" ToolTip="{x:Static p:Resources.MappoolBeatmapListItemView_DeleteButtonTooltip}">
                    <md:PackIcon Kind="Delete" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
